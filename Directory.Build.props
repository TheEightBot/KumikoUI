<Project>
  <!--
    Shared NuGet package metadata inherited by every project in the repository.
    Per-project values (PackageId, Description, PackageTags) are kept in the individual .csproj files.

    Versions come from git tags via MinVer (https://github.com/adamralph/minver): a commit tagged
    `v1.2.3` builds 1.2.3; any other commit builds the next version as a prerelease, e.g.
    0.2.0-alpha.0.5 (5 commits after the last tag). All four packages always share one version.
  -->
  <PropertyGroup>
    <Authors>Eight-Bot, Inc.; Michael Stonis</Authors>
    <Company>Eight-Bot, Inc.</Company>
    <!-- Fixed year (not the build date) so package metadata is reproducible; bump when releasing in a new year. -->
    <Copyright>Copyright © Eight-Bot, Inc. 2026</Copyright>

    <!-- Version from git tags (MinVer). Untagged builds after v0.1.x become 0.2.0-alpha.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.2</MinVerMinimumMajorMinor>

    <!-- Symbol packages (.snupkg) for every packable project, locally and in CI. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TheEightBot/KumikoUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheEightBot/KumikoUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Embed the README in every package (path relative to each project) -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NuGet package icon -->
    <PackageIcon>logo.png</PackageIcon>

    <!-- Deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>

    <!-- Embed portable PDB in the package for source-link / debugging -->
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Enable SourceLink for GitHub -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Minimum supported OS versions ("platform watermark"), shared by every library, sample and head
    (MAUI and Uno). Re-baselined at each .NET major release; see README "Supported platforms".
    Mac Catalyst 17.0 is also the floor the Xcode 27 toolchain enforces. Uno's desktop and WebAssembly
    heads have no OS version floor and are not affected.
  -->
  <PropertyGroup>
    <KumikoMinAndroidVersion>24.0</KumikoMinAndroidVersion>
    <KumikoMinIOSVersion>17.0</KumikoMinIOSVersion>
    <KumikoMinMacCatalystVersion>17.0</KumikoMinMacCatalystVersion>
    <KumikoMinWindowsVersion>10.0.19041.0</KumikoMinWindowsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <_KumikoPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_KumikoPlatform>
    <SupportedOSPlatformVersion Condition="'$(_KumikoPlatform)' == 'android'">$(KumikoMinAndroidVersion)</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(_KumikoPlatform)' == 'ios'">$(KumikoMinIOSVersion)</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(_KumikoPlatform)' == 'maccatalyst'">$(KumikoMinMacCatalystVersion)</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(_KumikoPlatform)' == 'windows'">$(KumikoMinWindowsVersion)</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(_KumikoPlatform)' == 'windows'">$(KumikoMinWindowsVersion)</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- Include README and icon in every package -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\"/>
    <None Include="$(MSBuildThisFileDirectory)images/logo.png" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <!--
    Source Link is built into the .NET SDK (8+) and enabled by PublishRepositoryUrl above, so no
    Microsoft.SourceLink.GitHub reference is needed. MinVer computes the version at build time.
  -->
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
</Project>
