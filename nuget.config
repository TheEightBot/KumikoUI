<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore from nuget.org only, regardless of feeds configured on the build machine, so local builds and
  CI resolve identical packages. Package source mapping is required with central package management
  when more than one source could be in play (NU1507).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
