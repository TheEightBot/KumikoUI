<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles every .NET MAUI documentation snippet (#87): the C# and XAML blocks of README.md and the other
    Markdown files eng/DocsSnippets reads. Never run, never packed, and not part of KumikoUI.sln.

        1. Run the extractor, eng/DocsSnippets (a console project; `dotnet run` it in Release).
        2. dotnet build tests/KumikoUI.Docs.Snippets.Maui -f net10.0-maccatalyst -c Release

    The extractor writes Generated/ (git-ignored). The exact commands are in CONTRIBUTING.md. Build in Release: that is the configuration where XamlC
    validates the XAML (types, properties, bindings, markup extensions) at build time. Mac Catalyst is the
    head because CI builds MAUI there anyway; the snippets are platform-neutral.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <DefineConstants>$(DefineConstants);DOCS_MAUI</DefineConstants>
    <!-- Snippets declare variables they never read and members they never call. -->
    <NoWarn>$(NoWarn);XC0022;XC0025;CS0168;CS0219;CS8321;CS1998;CS0414;CS0649;CS0169;CS8618</NoWarn>
  </PropertyGroup>

  <!-- No version stamping (Directory.Build.props adds MinVer to every project). -->
  <ItemGroup>
    <PackageReference Remove="MinVer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="../../src/KumikoUI.Maui/KumikoUI.Maui.csproj" />
    <!-- The KumikoUI.Core package ships the [KumikoGridItem] generator; a project reference has to wire it up. -->
    <ProjectReference Include="../../src/KumikoUI.SourceGenerators/KumikoUI.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../KumikoUI.Docs.Snippets.Shared/Fixtures.cs" Link="Fixtures.cs" />
  </ItemGroup>

  <!-- An empty Generated/ would compile nothing and pass; fail instead. -->
  <Target Name="RequireGeneratedSnippets" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_GeneratedSnippet Include="$(MSBuildProjectDirectory)/Generated/*.cs" />
    </ItemGroup>
    <Error Condition="'@(_GeneratedSnippet)' == ''"
           Text="No generated snippets in Generated/. Run the extractor first: dotnet run --project eng/DocsSnippets -c Release" />
  </Target>

</Project>
