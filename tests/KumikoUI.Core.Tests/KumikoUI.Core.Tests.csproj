<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <!-- Native Skia for the SkiaSharp backend tests on a Linux CI host. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real font for the SkiaFontRegistrar / SkiaResourceCache tests (#62). -->
    <EmbeddedResource Include="../../samples/SampleApp.Maui/Resources/Fonts/OpenSans-Regular.ttf"
                      LogicalName="KumikoUI.Core.Tests.OpenSans-Regular.ttf" Link="TestFonts/OpenSans-Regular.ttf" />
    <!-- Its semibold face, registered as a family's bold variant (#74). -->
    <EmbeddedResource Include="../../samples/SampleApp.Maui/Resources/Fonts/OpenSans-Semibold.ttf"
                      LogicalName="KumikoUI.Core.Tests.OpenSans-Semibold.ttf" Link="TestFonts/OpenSans-Semibold.ttf" />
    <!-- An icon font for the font icon provider tests (#119). -->
    <EmbeddedResource Include="../../samples/SampleApp.Maui/Resources/Raw/MaterialIcons-Regular.ttf"
                      LogicalName="KumikoUI.Core.Tests.MaterialIcons-Regular.ttf" Link="TestFonts/MaterialIcons-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/KumikoUI.Core/KumikoUI.Core.csproj" />
    <ProjectReference Include="../../src/KumikoUI.SkiaSharp/KumikoUI.SkiaSharp.csproj" />
    <!-- Runs the [KumikoGridItem] generator over the test models, as the package does in apps. -->
    <ProjectReference Include="../../src/KumikoUI.SourceGenerators/KumikoUI.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
