<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time tool, not a shipped package and not part of KumikoUI.sln. It fails the build when a public
    top-level KumikoUI type shares its simple name with a type in Microsoft.Maui.Controls.*,
    Microsoft.UI.Xaml.* or System.Windows.Forms.* (see "Public type names" in CONTRIBUTING.md).

    The platform type lists are read from the real packages, pinned in the repo-root Directory.Packages.props,
    so the check works on any OS (no MAUI, Uno or Windows workloads needed) and cannot go stale.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <RootNamespace>KumikoUI.Build.TypeNameCheck</RootNamespace>
  </PropertyGroup>

  <!-- No version stamping for a build tool (Directory.Build.props adds MinVer to every project). -->
  <ItemGroup>
    <PackageReference Remove="MinVer" />
  </ItemGroup>

  <!--
    PackageDownload restores exactly these packages (no dependency graph, nothing referenced or compiled
    against). Versions are the MauiVersion, WindowsAppSdkWinUIVersion, UnoWinUIVersion and
    WindowsDesktopRefVersion, CommunityToolkitWinUIDataGridVersion, CommunityToolkitMauiVersion, AvaloniaVersion
    and AvaloniaDataGridVersion properties in Directory.Packages.props.
  -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.Maui.Controls.Core" Version="[$(MauiVersion)]" />
    <PackageDownload Include="Microsoft.Maui.Controls.Xaml" Version="[$(MauiVersion)]" />
    <PackageDownload Include="Microsoft.Maui.Core" Version="[$(MauiVersion)]" />
    <PackageDownload Include="Microsoft.Maui.Graphics" Version="[$(MauiVersion)]" />
    <PackageDownload Include="Microsoft.WindowsAppSDK.WinUI" Version="[$(WindowsAppSdkWinUIVersion)]" />
    <PackageDownload Include="Uno.WinUI" Version="[$(UnoWinUIVersion)]" />
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[$(WindowsDesktopRefVersion)]" />
    <PackageDownload Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="[$(CommunityToolkitWinUIDataGridVersion)]" />
    <PackageDownload Include="CommunityToolkit.Maui" Version="[$(CommunityToolkitMauiVersion)]" />
    <PackageDownload Include="Avalonia" Version="[$(AvaloniaVersion)]" />
    <PackageDownload Include="Avalonia.Controls.DataGrid" Version="[$(AvaloniaDataGridVersion)]" />
  </ItemGroup>

  <!-- Hand the package locations to the tool so it never guesses paths. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NuGetPackageRoot</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MauiControlsVersion</_Parameter1>
      <_Parameter2>$(MauiVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WindowsAppSdkWinUIVersion</_Parameter1>
      <_Parameter2>$(WindowsAppSdkWinUIVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UnoWinUIVersion</_Parameter1>
      <_Parameter2>$(UnoWinUIVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WindowsDesktopRefVersion</_Parameter1>
      <_Parameter2>$(WindowsDesktopRefVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CommunityToolkitWinUIDataGridVersion</_Parameter1>
      <_Parameter2>$(CommunityToolkitWinUIDataGridVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CommunityToolkitMauiVersion</_Parameter1>
      <_Parameter2>$(CommunityToolkitMauiVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AvaloniaVersion</_Parameter1>
      <_Parameter2>$(AvaloniaVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AvaloniaDataGridVersion</_Parameter1>
      <_Parameter2>$(AvaloniaDataGridVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
