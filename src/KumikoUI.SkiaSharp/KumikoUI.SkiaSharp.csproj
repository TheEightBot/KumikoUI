<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../KumikoUI.Core/KumikoUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KumikoUI.Core.Tests" />
    <InternalsVisibleTo Include="KumikoUI.SkiaSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Native AOT and trimming safe; analyzer warnings are errors (Directory.Build.targets, #17). -->
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API is recorded in PublicAPI.*.txt files and checked by PublicApiAnalyzers (Directory.Build.targets, #54). -->
    <KumikoTrackPublicApi>true</KumikoTrackPublicApi>
    <!-- Package validation (#54); the baseline is described in Directory.Build.props. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- NuGet Package Metadata (Authors, License, URLs inherited from Directory.Build.props) -->
    <PackageId>KumikoUI.SkiaSharp</PackageId>
    <Description>SkiaSharp rendering engine for KumikoUI DataGrid. Provides cross-platform grid painting including cells, headers, selection, scrolling, and editing overlays.</Description>
    <PackageTags>datagrid;data-grid;grid;table;skiasharp;skia;rendering;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <!-- The package README shown on nuget.org: plain Markdown with absolute image URLs (#95). -->
  <ItemGroup>
    <None Include="../../docs/nuget/README.KumikoUI.SkiaSharp.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

</Project>
