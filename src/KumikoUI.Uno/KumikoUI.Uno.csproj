<!--
  The Uno.Sdk version comes from the repo-root global.json ("msbuild-sdks"), so the library, its tests
  and the sample always use the same Uno version, and Uno tooling (uno-check, IDE extensions) finds it.
-->
<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!--
      Uno single-project head TFMs (originally scaffolded with `dotnet new unolib -r skia` for .NET 9; retargeted to .NET 10 in #10).
      The Windows (WinAppSDK) head is conditioned on Windows only so non-Windows
      machines / CI don't try to build it (mirrors src/KumikoUI.Maui/KumikoUI.Maui.csproj).
    -->
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-android;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100</TargetFrameworks>

    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <!-- Ensures the .xr.xml files are generated in a proper layout folder (needed for packaged fonts/assets) -->
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      SkiaSharpVersion comes from the repo-root Directory.Packages.props (one version for every project).
      It overrides the version Uno.Sdk would otherwise apply to the implicit SkiaSharp group
      (incl. SkiaSharp.Views.Uno.WinUI): Uno ships SkiaSharp 3.x by default, and KumikoUI uses 4.x.
      Consumers of KumikoUI.Uno therefore get SkiaSharp 4 through this package's dependencies.
    -->

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
      SkiaRenderer also brings in SkiaSharp.Views.Uno.WinUI (which provides SkiaSharp.Views.Windows.SKXamlCanvas)
      on every non-Windows head, so Phase 03 can host the SKXamlCanvas.
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>

    <!--
      NuGet Package Metadata (Authors, License, URLs inherited from Directory.Build.props).
      Uno.Sdk defaults IsPackable to false for single-projects (it ties it to GeneratePackageOnBuild),
      so opt back in explicitly to make the library packable like its sibling KumikoUI.* projects.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>KumikoUI.Uno</PackageId>
    <Version>1.0.0</Version>
    <Description>A high-performance, fully custom-drawn KumikoUI DataGrid control for the Uno Platform. Renders via SkiaSharp (SKXamlCanvas) across Windows, Desktop, WebAssembly, Android, iOS, and Mac Catalyst — reusing the same engine as KumikoUI.Maui.</Description>
    <PackageTags>uno;unoplatform;winui;datagrid;grid;table;skiasharp;dotnet;cross-platform</PackageTags>
  </PropertyGroup>

  <!--
    The Windows (WinAppSDK) head's SkiaSharp.Views package (SkiaSharp.Views.WinUI) is NOT pulled in by
    the SkiaRenderer UnoFeature (that gate only fires for the skia/lottie/svg features), so reference it
    explicitly on the Windows head so SKXamlCanvas (namespace SkiaSharp.Views.Windows) resolves there too.
    Uno dedups implicit references against explicit ones, so this also keeps the version at $(SkiaSharpVersion).
  -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="SkiaSharp.Views.WinUI" />
  </ItemGroup>

  <!--
    Uno's runtime packages reference some SkiaSharp packages directly at 3.x, outside the implicit
    group that SkiaSharpVersion overrides: SkiaSharp.Views (Android/iOS runtimes),
    SkiaSharp.NativeAssets.Linux (X11 / framebuffer desktop runtimes) and SkiaSharp.Skottie with its
    SceneGraph/Resources dependencies (Uno.WinUI.Lottie). Left alone, an app would combine SkiaSharp 4
    managed code with a SkiaSharp 3 native library on Linux, which fails at load. Referencing them here
    at $(SkiaSharpVersion) makes every consumer of KumikoUI.Uno resolve one SkiaSharp major
    (NuGet picks the highest version among equal-depth dependencies).
  -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android')) or $(TargetFramework.Contains('-ios'))">
    <PackageReference Include="SkiaSharp.Views" />
    <PackageReference Include="SkiaSharp.Skottie" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-desktop'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <!--
    Core and SkiaSharp are plain Microsoft.NET.Sdk libraries that target only `net10.0`, while this is
    a multi-head Uno project. UndefineProperties stops this project's per-head TargetFramework from
    flowing into the P2P build of those single-TFM dependencies, so each resolves its own net10.0
    output. (To scope a local build to one head use `-f net10.0-desktop`, NOT
    `-p:TargetFrameworks=net10.0-desktop` — the latter is a global property that reaches the
    dependencies at restore time and fails them with NETSDK1139 'desktop was not recognized'.)
  -->
  <ItemGroup>
    <ProjectReference Include="../KumikoUI.Core/KumikoUI.Core.csproj" UndefineProperties="TargetFramework;TargetFrameworks" />
    <ProjectReference Include="../KumikoUI.SkiaSharp/KumikoUI.SkiaSharp.csproj" UndefineProperties="TargetFramework;TargetFrameworks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the Uno test project exercise internal, platform-parameterised mapping overloads. -->
    <InternalsVisibleTo Include="KumikoUI.Uno.Tests" />
  </ItemGroup>

  <!--
    KumikoUIHostingExtensions.UseKumikoUI extends Microsoft.Extensions.Hosting.IHostBuilder
    (the host obtained from IApplicationBuilder in an Uno app's App.xaml.cs — see docs/uno/03).
    The Uno.Sdk library head does not transitively reference the hosting abstractions, so add the
    abstractions package directly (it carries only IHostBuilder, no runtime), keeping the extension
    minimal and the documented signature intact.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!--
    If you encounter this error message:

      error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
      Please update to a newer .NET SDK in order to reference this assembly.

    This means that the two packages below must be aligned with the "build" version number of
    the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
    must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref" RuntimeFrameworkVersion="10.0.22621.28" />
    <FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref" TargetingPackVersion="10.0.22621.28" /> -->
  </ItemGroup>
</Project>
