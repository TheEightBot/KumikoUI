<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Native AOT and trimming safe; analyzer warnings are errors (Directory.Build.targets, #17). -->
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Metadata (Authors, License, URLs inherited from Directory.Build.props) -->
    <PackageId>KumikoUI.Core</PackageId>
    <Description>Core data models, abstractions, and data-source logic for KumikoUI DataGrid. Platform-independent — no rendering or UI framework references.</Description>
    <PackageTags>datagrid;data-grid;grid;table;dotnet;skia;aot;source-generator;core</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    The [KumikoGridItem] source generator ships inside this package (analyzers/dotnet/cs). Built first,
    never referenced at compile time, and not a package dependency.
  -->
  <ItemGroup>
    <ProjectReference Include="../KumikoUI.SourceGenerators/KumikoUI.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="../KumikoUI.SourceGenerators/bin/$(Configuration)/netstandard2.0/KumikoUI.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Switches the reflection fallback off for Native AOT and full-trim publishes (see the file). -->
    <None Include="buildTransitive/KumikoUI.Core.targets" Pack="true" PackagePath="buildTransitive/;build/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project check internal editing state, such as the editor the focus manager holds. -->
    <InternalsVisibleTo Include="KumikoUI.Core.Tests" />
    <!-- The hosts hand the input controller's popup manager to the renderer; neither is public API (#37). -->
    <InternalsVisibleTo Include="KumikoUI.Maui" />
    <InternalsVisibleTo Include="KumikoUI.Uno" />
    <!-- The MAUI sample's DevFlow diagnostics read the open popup (a test aid, not shipped behavior). -->
    <InternalsVisibleTo Include="SampleApp.Maui" />
    <!-- The host test projects compile the host sources and drive the drawn focus manager directly. -->
    <InternalsVisibleTo Include="KumikoUI.Maui.Tests" />
    <InternalsVisibleTo Include="KumikoUI.Uno.Tests" />
  </ItemGroup>
  <!-- The package README shown on nuget.org: plain Markdown with absolute image URLs (#95). -->
  <ItemGroup>
    <None Include="../../docs/nuget/README.KumikoUI.Core.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

</Project>
