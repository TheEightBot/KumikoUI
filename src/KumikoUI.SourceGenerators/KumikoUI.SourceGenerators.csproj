<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishTrimmed;TrimMode;PublishAot;IsTrimmable;IsAotCompatible">

  <!--
    Roslyn source generator for [KumikoGridItem] (#17). Shipped inside the KumikoUI.Core package
    (analyzers/dotnet/cs), not as a package of its own. netstandard2.0 is what the compiler loads.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- An app's `dotnet publish -p:PublishTrimmed=true` (or PublishAot) reaches this project as a global property
         through the project references, and netstandard2.0 cannot be trimmed (NETSDK1124). It is a compiler
         plug-in, never published, so those properties are local here and off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <RootNamespace>KumikoUI.SourceGenerators</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Analyzer release tracking for the KUMIKO diagnostics. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
