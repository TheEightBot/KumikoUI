<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Native AOT and trimming safe; analyzer warnings are errors (Directory.Build.targets, #17). -->
		<IsAotCompatible>true</IsAotCompatible>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Public API is recorded in PublicAPI.*.txt files and checked by PublicApiAnalyzers (Directory.Build.targets, #54). -->
		<KumikoTrackPublicApi>true</KumikoTrackPublicApi>
		<!-- Package validation (#54); the baseline is described in Directory.Build.props. -->
		<EnablePackageValidation>true</EnablePackageValidation>
		<!-- The recommended code-analysis rules (#112); Directory.Build.props sets `latest` for tests and samples. -->
		<AnalysisLevel>latest-recommended</AnalysisLevel>

		<!-- NuGet Package Metadata (Authors, License, URLs inherited from Directory.Build.props) -->
		<PackageId>KumikoUI.Maui</PackageId>
		<Description>A high-performance, fully custom-drawn KumikoUI DataGrid control for .NET MAUI. Features virtual scrolling, sorting, filtering, grouping, cell editing, theming, row drag-and-drop, frozen columns/rows, and table/group summaries, drawn with SkiaSharp.</Description>
		<PackageTags>maui;dotnet-maui;datagrid;data-grid;grid;table;skiasharp;android;ios;maccatalyst;windows;cross-platform</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!--
		  The library has no Android resources, so it needs no Resource designer class: without this the Android build adds a
		  public KumikoUI.Maui.Resource type to the package (#112).
		-->
		<AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="../KumikoUI.Core/KumikoUI.Core.csproj" />
	  <ProjectReference Include="../KumikoUI.SkiaSharp/KumikoUI.SkiaSharp.csproj" />
	</ItemGroup>
  <!-- The package README shown on nuget.org: plain Markdown with absolute image URLs (#95). -->
  <ItemGroup>
    <None Include="../../docs/nuget/README.KumikoUI.Maui.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

</Project>
