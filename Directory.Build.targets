<Project>
  <!--
    Libraries marked IsAotCompatible (KumikoUI.Core, .SkiaSharp, .Maui, .Uno) must stay free of trimming,
    Native AOT and single-file analyzer warnings (#17).
    - EnableTrimAnalyzer is forced on because the Apple workloads turn it off for library builds.
    - Every IL2xxx/IL3xxx analyzer warning is an error, so a regression fails the build instead of
      surfacing as a warning in apps that publish with trimming or Native AOT.
  -->
  <PropertyGroup Condition="'$(IsAotCompatible)' == 'true'">
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);IL2001;IL2002;IL2003;IL2004;IL2005;IL2006;IL2007;IL2008;IL2009;IL2010;IL2011;IL2012;IL2013;IL2014;IL2015;IL2016;IL2017;IL2018;IL2019;IL2020;IL2021;IL2022;IL2023;IL2024;IL2025;IL2026;IL2027;IL2028;IL2029;IL2030;IL2031;IL2032;IL2033;IL2034;IL2035;IL2036;IL2037;IL2038;IL2039;IL2040;IL2041;IL2042;IL2043;IL2044;IL2045;IL2046;IL2047;IL2048;IL2049;IL2050;IL2051;IL2052;IL2053;IL2054;IL2055;IL2056;IL2057;IL2058;IL2059;IL2060;IL2061;IL2062;IL2063;IL2064;IL2065;IL2066;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL2100;IL2101;IL2102;IL2103;IL2104;IL2105;IL2106;IL2107;IL2108;IL2109;IL2110;IL2111;IL2112;IL2113;IL2114;IL2115;IL2116;IL2117;IL2118;IL2119;IL2120;IL2121;IL2122;IL2123;IL3000;IL3001;IL3002;IL3003;IL3004;IL3005;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056;IL3057;IL3058</WarningsAsErrors>
  </PropertyGroup>
  <!--
    The four shipped libraries (those that set GenerateDocumentationFile) must document every public
    member and keep their XML docs well-formed: a missing comment (CS1591) or a malformed, unresolvable
    or mismatched doc comment fails the build instead of surfacing as a warning (#54). Tests, samples and
    benchmarks do not generate docs, so they are unaffected.
  -->
  <PropertyGroup Condition="'$(GenerateDocumentationFile)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734</WarningsAsErrors>
  </PropertyGroup>
  <!--
    Public API tracking for the four shipped libraries (those that set KumikoTrackPublicApi, #54). The analyzer compares
    the public surface with the PublicAPI.*.txt files next to the project:
      - PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt hold the members present in every target framework.
      - PublicAPI/<TargetFramework>/PublicAPI.Shipped.txt and .Unshipped.txt (optional) hold members only that target
        framework has, such as the platform-specific handlers of KumikoUI.Maui and KumikoUI.Uno. The analyzer merges the
        files that apply to the target framework being built.
    RS0016 (public API not recorded) and RS0017 (recorded API no longer exists) are errors, so an API change that is not
    written down fails the build. Nothing has shipped as a stable release yet, so every Shipped file is empty and the whole
    surface lives in the Unshipped files; at the first stable release, move the Unshipped content into Shipped (CONTRIBUTING.md).
  -->
  <ItemGroup Condition="'$(KumikoTrackPublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" Condition="Exists('PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt')" />
  </ItemGroup>
  <PropertyGroup Condition="'$(KumikoTrackPublicApi)' == 'true'">
    <!--
      RS0026 (only one overload of a method may have optional parameters) and RS0027 (that overload must have the most
      parameters) are errors too (#112): an overload set that breaks them cannot take a new optional parameter later without
      a source or binary break.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0025;RS0026;RS0027;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>
  <!--
    The KumikoUI packages ship in lockstep (one MinVer version), and the hosts call KumikoUI.Core internals through
    InternalsVisibleTo (#112, decision D3). Pin each package's dependency on another KumikoUI package to its exact
    version ([1.0.0], not >= 1.0.0), so a mismatched set fails at restore instead of with MissingMethodException.
  -->
  <Target Name="KumikoPinSiblingPackageVersions"
          AfterTargets="_GetProjectReferenceVersions"
          Condition="'$(KumikoTrackPublicApi)' == 'true'">
    <ItemGroup>
      <_KumikoPinnedReferences Include="@(_ProjectReferencesWithVersions)"
                               ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_KumikoPinnedReferences)" />
    </ItemGroup>
  </Target>
  <!--
    Apps in this repository (samples, eng/AotSmoke) reference KumikoUI.Core by project, so the targets the
    NuGet package delivers through buildTransitive are not applied to them. Import the same file so a
    PublishAot or TrimMode=full publish switches the reflection fallback off, as it does for package consumers (#76).
  -->
  <Import Project="$(MSBuildThisFileDirectory)src/KumikoUI.Core/buildTransitive/KumikoUI.Core.targets"
          Condition="'$(OutputType)' == 'Exe' and '$(IsPackable)' != 'true'" />
</Project>
