<Project Sdk="Microsoft.NET.Sdk">

  <!-- Property-access benchmarks for #17, not run in CI. See bench/README.md for how to run them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Remove="MinVer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/KumikoUI.Core/KumikoUI.Core.csproj" />
    <ProjectReference Include="../../src/KumikoUI.SourceGenerators/KumikoUI.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
