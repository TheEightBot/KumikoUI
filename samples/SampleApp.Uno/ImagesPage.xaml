<Page x:Class="SampleApp.Uno.ImagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:kumiko="using:KumikoUI.Uno"
      xmlns:core="using:KumikoUI.Core.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Image columns (← SampleApp.Maui ImagesPage). -->
    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Image columns: bundled assets, a BitmapImage and web URLs over 10,000 rows"
                   FontSize="16"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Padding="16,12,16,4"
                   Grid.Row="0" />

        <!-- Updated every second from the grid's ImageCache: the count stays bounded however far you scroll. -->
        <TextBlock x:Name="cacheLabel"
                   FontSize="13"
                   Foreground="Gray"
                   Padding="16,0,16,6"
                   Grid.Row="1" />

        <kumiko:KumikoDataGrid x:Name="kumiko"
                               Grid.Row="2"
                               RowHeight="44"
                               HeaderHeight="40"
                               EditTriggers="None"
                               GridDescription="Image columns sample grid">
            <core:KumikoColumn Header="#" PropertyName="Id" Width="80"
                               ColumnType="Numeric" TextAlignment="Right" IsFrozen="True" />
            <core:KumikoColumn Header="Name" PropertyName="Name" Width="160" />

            <!-- An app package path (Assets/Avatars/avatar-N.png, i.e. ms-appx:///Assets/Avatars/...) -->
            <core:KumikoColumn Header="Asset" PropertyName="Avatar" Width="70" ColumnType="Image" />

            <!-- A BitmapImage of the same assets: cached once per URI -->
            <core:KumikoColumn Header="BitmapImage" PropertyName="AvatarImage" Width="100" ColumnType="Image" />

            <!-- Web images downloaded through the grid's shared HttpClient -->
            <core:KumikoColumn Header="URL" PropertyName="PhotoUrl" Width="70" ColumnType="Image" />
            <core:KumikoColumn Header="Photo URL" PropertyName="PhotoUrl" Width="320" />
        </kumiko:KumikoDataGrid>
    </Grid>
</Page>
