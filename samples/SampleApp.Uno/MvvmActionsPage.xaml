<Page x:Class="SampleApp.Uno.MvvmActionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:kumiko="using:KumikoUI.Uno"
      xmlns:core="using:KumikoUI.Core.Models"
      xmlns:render="using:KumikoUI.Core.Rendering"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="MVVM selection + Per-Column EditTriggers + Action Buttons"
                   FontSize="18"
                   FontWeight="Bold"
                   Padding="16,12,16,2"
                   Grid.Row="0" />

        <!-- Per-column trigger legend -->
        <StackPanel Grid.Row="1" Padding="16,0,16,8" Spacing="2">
            <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                       Text="Name: single-tap / F2 / type    Department: double-tap or F2    Level: double-tap only" />
            <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                       Text="Salary: F2 only (most protected)    Actions: single-tap (Details / Delete commands bound to the VM)" />
        </StackPanel>

        <!--
            Selection from the view model: SelectedItem is two-way, SelectedItems is the VM's own
            collection (kept in sync by the grid), and SelectionChangedCommand gets the added and
            removed items. Sort or filter the grid and the selection stays on the same employees.
        -->
        <StackPanel Grid.Row="2" Padding="16,0,16,8" Spacing="2">
            <TextBlock Text="{Binding SelectionSummary}" FontSize="13" FontWeight="Bold" />
            <TextBlock Text="{Binding LastChange}" FontSize="12" Foreground="Gray" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Select first" Click="OnSelectFirstClick" />
                <Button Content="Clear" Click="OnClearSelectionClick" />
            </StackPanel>
        </StackPanel>

        <!--
            Columns are declared in XAML, including the Actions column's buttons. A
            UnoActionButtonDefinition is not in the visual tree, so the grid hands it its own DataContext
            (the page's view model here) and a plain {Binding Command} resolves against it.
            ItemsSource is set in code-behind after the view model has loaded its data.
        -->
        <kumiko:KumikoDataGrid x:Name="actionsGrid"
                             Grid.Row="3"
                             SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                             SelectedItems="{Binding SelectedEmployees, Mode=OneWay}"
                             SelectionChangedCommand="{Binding SelectionChangedCommand}"
                             EditTriggers="DoubleTap,F2Key,Typing"
                             RowHeight="44"
                             HeaderHeight="40"
                             GridDescription="MVVM employee grid with action buttons"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch">
            <!-- Id: read-only. -->
            <core:KumikoColumn Header="Id" PropertyName="Id" ColumnType="Numeric"
                               Width="72" IsReadOnly="True" AllowTabStop="False" />

            <!-- Name: single-tap, F2, or typing starts editing (most accessible). -->
            <core:KumikoColumn Header="Name" PropertyName="Name" Width="160"
                               EditTriggers="SingleTap,F2Key,Typing" />

            <!-- Department: double-tap or F2 only (typing excluded for a ComboBox). -->
            <core:KumikoColumn Header="Department" PropertyName="Department" ColumnType="ComboBox"
                               Width="130"
                               EditorItemsString="Engineering,Marketing,Finance,HR,Design,Product,Sales"
                               EditTriggers="DoubleTap,F2Key" />

            <!-- Level: double-tap only. -->
            <core:KumikoColumn Header="Level" PropertyName="Level" ColumnType="Picker"
                               Width="90"
                               EditorItemsString="Junior,Mid,Senior,Lead,Principal"
                               EditTriggers="DoubleTap" />

            <!-- Salary: F2 only (protects financial data from pointer gestures). -->
            <core:KumikoColumn Header="Salary" PropertyName="Salary" ColumnType="Numeric"
                               Format="C0" Width="110" TextAlignment="Right"
                               EditTriggers="F2Key" />

            <!-- Active: Boolean, toggles on tap. -->
            <core:KumikoColumn Header="Active" PropertyName="IsActive" ColumnType="Boolean" />

            <!--
                Actions: a Template column with inline action buttons. ActionButtonsCellRenderer is an
                interactive cell, so a tap runs the button without an editor. PropertyName="" passes the
                whole Employee as the cell value, so it is the Command parameter.
            -->
            <core:KumikoColumn Header="Actions" PropertyName="" ColumnType="Template"
                               Width="200" AllowSorting="False" AllowFiltering="False"
                               SizeMode="Star" StarWeight="1">
                <core:KumikoColumn.CustomCellRenderer>
                    <render:ActionButtonsCellRenderer>
                        <render:ActionButtonsCellRenderer.Buttons>
                            <kumiko:UnoActionButtonDefinition Label="Details"
                                                              BackgroundColor="#FF0D6EFD"
                                                              Command="{Binding ViewDetailsCommand}" />
                            <kumiko:UnoActionButtonDefinition Label="Delete"
                                                              BackgroundColor="#FFDC3545"
                                                              Command="{Binding DeleteCommand}" />
                        </render:ActionButtonsCellRenderer.Buttons>
                    </render:ActionButtonsCellRenderer>
                </core:KumikoColumn.CustomCellRenderer>
            </core:KumikoColumn>
        </kumiko:KumikoDataGrid>
    </Grid>

</Page>
