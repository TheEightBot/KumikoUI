<Page x:Class="SampleApp.Uno.BasicGridPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:kumiko="using:KumikoUI.Uno"
      xmlns:core="using:KumikoUI.Core.Models"
      xmlns:render="using:KumikoUI.Core.Rendering"
      xmlns:editing="using:KumikoUI.Core.Editing"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="KumikoUI.Uno — All Components"
                   FontSize="20"
                   FontWeight="Bold"
                   Padding="16,12"
                   Grid.Row="0" />

        <!-- Demo buttons (WrapPanel-like row of toggles) -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Padding="16,4"
                    Spacing="8">
            <Button Content="Add Row" Click="OnAddRowClicked" />
            <Button Content="Remove Last Row" Click="OnRemoveLastRowClicked" />
            <Button Content="Update Random Salary" Click="OnUpdateRandomSalaryClicked" />
            <Button Content="Randomize Ratings" Click="OnRandomizeRatingsClicked" />
            <Button x:Name="themeToggle" Content="Theme: Light" Click="OnToggleThemeClicked" />
            <Button x:Name="selectionModeToggle" Content="Select: All" Click="OnToggleSelectionModeClicked" />
        </StackPanel>

        <kumiko:DataGridView x:Name="kumiko"
                             Grid.Row="2"
                             ItemsSource="{Binding Employees}"
                             EditTriggers="DoubleTap,F2Key,Typing"
                             EditTextSelectionMode="SelectAll"
                             DismissKeyboardOnEnter="True"
                             FrozenRowCount="2"
                             RowHeight="36"
                             HeaderHeight="40"
                             GridDescription="Employee data grid with all component types"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch">

            <!-- Column definitions — showcasing every column/component type -->
            <kumiko:DataGridView.Columns>

                <!-- NUMERIC column (frozen left) -->
                <core:DataGridColumn Header="Id"
                                     PropertyName="Id"
                                     Width="60"
                                     ColumnType="Numeric"
                                     TextAlignment="Right"
                                     IsReadOnly="True"
                                     AllowTabStop="False"
                                     IsFrozen="True" />

                <!-- TEXT column (frozen left) -->
                <core:DataGridColumn Header="Name"
                                     PropertyName="Name"
                                     Width="160"
                                     IsFrozen="True" />

                <!-- COMBOBOX column — dropdown editor with items declared in XAML -->
                <core:DataGridColumn Header="Department"
                                     PropertyName="Department"
                                     Width="140"
                                     ColumnType="ComboBox"
                                     EditorItemsString="Engineering,Marketing,Sales,HR,Finance,Design,Support" />

                <!-- NUMERIC column with currency format -->
                <core:DataGridColumn Header="Salary"
                                     PropertyName="Salary"
                                     Width="120"
                                     Format="C0"
                                     ColumnType="Numeric"
                                     TextAlignment="Right" />

                <!-- DATE column — calendar picker editor -->
                <core:DataGridColumn Header="Hire Date"
                                     PropertyName="HireDate"
                                     Width="120"
                                     Format="yyyy-MM-dd"
                                     ColumnType="Date" />

                <!-- BOOLEAN column — checkbox toggle (skipped during tab navigation) -->
                <core:DataGridColumn Header="Active"
                                     PropertyName="IsActive"
                                     Width="80"
                                     ColumnType="Boolean"
                                     AllowTabStop="False" />

                <!-- PICKER column — scroll-wheel picker with items declared in XAML -->
                <core:DataGridColumn Header="Level"
                                     PropertyName="Level"
                                     Width="120"
                                     ColumnType="Picker"
                                     EditorItemsString="Junior,Mid,Senior,Staff,Principal,Director" />

                <!-- TEMPLATE column — progress bar display for Performance (fully declarative) -->
                <core:DataGridColumn Header="Performance"
                                     PropertyName="Performance"
                                     Width="140"
                                     ColumnType="Template"
                                     IsReadOnly="True">
                    <core:DataGridColumn.CustomCellRenderer>
                        <render:ProgressBarCellRenderer Minimum="0"
                                                        Maximum="100"
                                                        TrackHeight="12"
                                                        CornerRadius="6"
                                                        ShowText="True"
                                                        TextFormat="N0" />
                    </core:DataGridColumn.CustomCellRenderer>
                </core:DataGridColumn>

                <!-- TEMPLATE column — numeric up/down for Rating (fully declarative) -->
                <core:DataGridColumn Header="Rating"
                                     PropertyName="Rating"
                                     Width="100"
                                     ColumnType="Template">
                    <core:DataGridColumn.EditorDescriptor>
                        <editing:NumericUpDownEditorDescriptor Minimum="1"
                                                               Maximum="5"
                                                               Step="1"
                                                               DecimalPlaces="0" />
                    </core:DataGridColumn.EditorDescriptor>
                </core:DataGridColumn>

                <!-- TEXT column (frozen right) -->
                <core:DataGridColumn Header="City"
                                     PropertyName="City"
                                     Width="130"
                                     FreezeMode="Right" />
            </kumiko:DataGridView.Columns>

            <!-- Table summary rows -->
            <kumiko:DataGridView.TableSummaryRows>
                <core:TableSummaryRow Name="Averages" Position="Top" Title="Averages">
                    <core:TableSummaryRow.Columns>
                        <core:SummaryColumnDescription PropertyName="Salary"
                                                       SummaryType="Average"
                                                       Format="C0" />
                        <core:SummaryColumnDescription PropertyName="Performance"
                                                       SummaryType="Average"
                                                       Format="N1" />
                        <core:SummaryColumnDescription PropertyName="Rating"
                                                       SummaryType="Average"
                                                       Format="N1" />
                    </core:TableSummaryRow.Columns>
                </core:TableSummaryRow>

                <core:TableSummaryRow Name="Totals" Position="Bottom" Title="Totals">
                    <core:TableSummaryRow.Columns>
                        <core:SummaryColumnDescription PropertyName="Salary"
                                                       SummaryType="Sum"
                                                       Format="C0" />
                        <core:SummaryColumnDescription PropertyName="Id"
                                                       SummaryType="Count"
                                                       Label="Rows: " />
                        <core:SummaryColumnDescription PropertyName="Rating"
                                                       SummaryType="Max"
                                                       Label="Best: " />
                    </core:TableSummaryRow.Columns>
                </core:TableSummaryRow>
            </kumiko:DataGridView.TableSummaryRows>

        </kumiko:DataGridView>
    </Grid>

</Page>
