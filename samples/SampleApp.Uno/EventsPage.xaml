<Page x:Class="SampleApp.Uno.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:kumiko="using:KumikoUI.Uno"
      xmlns:core="using:KumikoUI.Core.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Events and selection (← SampleApp.Maui EventsPage). -->
    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <TextBlock Text="Events and selection: tap, right-click or long-press, edit a salary above 200,000"
                   FontSize="16"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Padding="16,12,16,4"
                   Grid.Row="0" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="16,4" Spacing="8">
                <!-- KumikoDataGrid.GridSelectionMode: None, Single, Multiple, Extended -->
                <Button x:Name="modeToggle" Content="Selection: Extended" Click="OnToggleModeClicked" />
                <!-- KumikoLayoutState: GetLayoutState().ToJson() and ApplyLayoutState(FromJson(...)) -->
                <Button x:Name="saveLayoutButton" Content="Save Layout" Click="OnSaveLayoutClicked" />
                <Button x:Name="restoreLayoutButton" Content="Restore Layout" Click="OnRestoreLayoutClicked" />
                <!-- KumikoSource.Culture and Strings: the language of numbers, dates and the grid's own text -->
                <Button x:Name="languageToggle" Content="Language: English" Click="OnToggleLanguageClicked" />
                <!-- KumikoDataGrid.ScrollSettings -->
                <Button x:Name="scrollToggle" Content="Scrolling: Default" Click="OnToggleScrollClicked" />
                <Button Content="Clear Log" Click="OnClearLogClicked" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="selectionLabel" Text="Selected: none (0 selected)" FontSize="13" Foreground="Gray"
                   Padding="16,0,16,6" Grid.Row="2" />

        <kumiko:KumikoDataGrid x:Name="kumiko"
                               Grid.Row="3"
                               RowHeight="40"
                               HeaderHeight="40"
                               GridSelectionMode="Extended"
                               ClipboardCopyIncludesHeaders="True"
                               GridDescription="Events and selection sample grid">
            <core:KumikoColumn Header="#" PropertyName="Id" Width="70"
                               ColumnType="Numeric" TextAlignment="Right" IsReadOnly="True" />
            <core:KumikoColumn Header="Name" PropertyName="Name" Width="160" />
            <core:KumikoColumn Header="Department" PropertyName="Department" Width="130" />
            <core:KumikoColumn Header="Salary" PropertyName="Salary" Width="120"
                               Format="C0" ColumnType="Numeric" TextAlignment="Right" />
            <core:KumikoColumn Header="Score" PropertyName="Score" Width="100"
                               Format="N1" ColumnType="Numeric" TextAlignment="Right" />
            <core:KumikoColumn Header="Active" PropertyName="IsActive" Width="90" ColumnType="Boolean" />
        </kumiko:KumikoDataGrid>

        <!-- The newest event first -->
        <TextBox x:Name="logBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" FontSize="12"
                 TextWrapping="NoWrap" PlaceholderText="Events appear here"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
