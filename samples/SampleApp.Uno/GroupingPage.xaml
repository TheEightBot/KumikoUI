<Page x:Class="SampleApp.Uno.GroupingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:kumiko="using:KumikoUI.Uno"
      xmlns:core="using:KumikoUI.Core.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Grouping &amp; Summaries"
                   FontSize="20"
                   FontWeight="Bold"
                   Padding="16,12"
                   Grid.Row="0" />

        <!-- Scrolls horizontally so every action stays reachable on phone-width viewports. -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal"
                        Padding="16,4"
                        Spacing="8">
                <Button Content="Group: Department" Click="OnGroupByDepartmentClicked" />
                <Button Content="Group: Level" Click="OnGroupByLevelClicked" />
                <Button Content="Group: Both" Click="OnGroupByBothClicked" />
                <Button Content="Clear Groups" Click="OnClearGroupsClicked" />
                <Button Content="Expand All" Click="OnExpandAllClicked" />
                <Button Content="Collapse All" Click="OnCollapseAllClicked" />
                <Button x:Name="groupSummaryToggle" Content="Add Group Summary" Click="OnAddGroupSummaryClicked" />
                <Button x:Name="filterToggle" Content="Filtering: ON" Click="OnToggleFilteringClicked" />
            </StackPanel>
        </ScrollViewer>

        <kumiko:KumikoDataGrid x:Name="kumiko"
                             Grid.Row="2"
                             ItemsSource="{Binding Employees}"
                             RowHeight="34"
                             HeaderHeight="40"
                             GridDescription="Grouped employee data grid"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch">
            <kumiko:KumikoDataGrid.Columns>
                <core:KumikoColumn Header="Id" PropertyName="Id" Width="60"
                                     ColumnType="Numeric" TextAlignment="Right"
                                     IsReadOnly="True" AllowTabStop="False" />
                <core:KumikoColumn Header="Name" PropertyName="Name" Width="170" />
                <core:KumikoColumn Header="Department" PropertyName="Department" Width="140" />
                <core:KumikoColumn Header="Level" PropertyName="Level" Width="120" />
                <core:KumikoColumn Header="Salary" PropertyName="Salary" Width="120"
                                     Format="C0" ColumnType="Numeric" TextAlignment="Right" />
                <core:KumikoColumn Header="Active" PropertyName="IsActive" Width="80"
                                     ColumnType="Boolean" AllowTabStop="False" />
                <core:KumikoColumn Header="City" PropertyName="City" Width="140" />
            </kumiko:KumikoDataGrid.Columns>
        </kumiko:KumikoDataGrid>
    </Grid>

</Page>
