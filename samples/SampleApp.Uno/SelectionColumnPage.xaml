<Page x:Class="SampleApp.Uno.SelectionColumnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:kumiko="using:KumikoUI.Uno"
      xmlns:core="using:KumikoUI.Core.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="statusLabel"
                   Text="Selection Column"
                   FontSize="20"
                   FontWeight="Bold"
                   Padding="16,12"
                   Grid.Row="0" />

        <!-- Scrolls horizontally so every option stays reachable on phone-width viewports. -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="16,4" Spacing="8">
                <ToggleSwitch x:Name="columnSwitch" IsOn="True" OnContent="Selection column" OffContent="Selection column"
                              Toggled="OnColumnToggled" />
                <ToggleSwitch x:Name="rowClickSwitch" IsOn="True" OnContent="Select on row tap" OffContent="Select on row tap"
                              Toggled="OnRowClickToggled" />
                <Button Content="None" Click="OnModeClicked" Tag="None" />
                <Button Content="Single" Click="OnModeClicked" Tag="Single" />
                <Button Content="Multiple" Click="OnModeClicked" Tag="Multiple" />
                <Button Content="Extended" Click="OnModeClicked" Tag="Extended" />
            </StackPanel>
        </ScrollViewer>

        <kumiko:KumikoDataGrid x:Name="kumiko"
                               Grid.Row="2"
                               ShowSelectionColumn="True"
                               GridSelectionMode="Multiple"
                               AllowSorting="True"
                               GridDescription="Tasks with a column of selection check boxes">
            <kumiko:KumikoDataGrid.Columns>
                <core:KumikoColumn Header="Task" PropertyName="Title" Width="200" />
                <core:KumikoColumn Header="Owner" PropertyName="Owner" Width="140" />
                <core:KumikoColumn Header="Status" PropertyName="Status" Width="120" />
                <core:KumikoColumn Header="Hours" PropertyName="Hours" Width="90" ColumnType="Numeric" />
            </kumiko:KumikoDataGrid.Columns>
        </kumiko:KumikoDataGrid>
    </Grid>
</Page>
