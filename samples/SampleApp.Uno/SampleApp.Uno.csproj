<!--
  The Uno.Sdk version comes from the repo-root global.json ("msbuild-sdks"), and package versions from
  the repo-root Directory.Packages.props (central package management), as the unoapp template sets up.
-->
<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!--
      Uno single-project head TFMs. The sample and the library KumikoUI.Uno both target .NET 10
      (docs/uno ADR-4, #10), so each app head binds the library's matching head directly. The Windows (WinAppSDK) head is conditioned on Windows
      only so non-Windows machines / CI don't try to build it. Day to day you build one head with
      `-f net10.0-desktop`, but restore walks every head listed here: a local restore needs the workloads of
      all of them (`wasm-tools`, plus the mobile heads' workloads, see CONTRIBUTING.md), even when you only
      build the desktop head. CI builds and verifies the other heads (Phase 08).
    -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!--
      The template put these in its generated Directory.Build.props; baked in here because the repo
      root has its own Directory.Build.props.
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      NU1507: multiple package sources with CPM (N/A — CPM disabled); NETSDK1201: RID without
      self-contained; PRI257: default language not in included resources. Suppress template noise.
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>

    <!-- This is a sample app, not a NuGet package. -->
    <IsPackable>false</IsPackable>

    <!-- Display name -->
    <ApplicationTitle>SampleApp.Uno</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.eightbot.kumikoui.sampleapp.uno</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Eight-Bot, Inc.</ApplicationPublisher>
    <!-- Package Description -->
    <Description>KumikoUI.Uno sample app — exercises the KumikoDataGrid control across every Uno head.</Description>

    <!--
      SkiaSharpVersion comes from the repo-root Directory.Packages.props so the app's implicit SkiaSharp
      group (incl. SkiaSharp.Views.Uno.WinUI from the SkiaRenderer feature) matches KumikoUI.SkiaSharp.
      An app consuming the NuGet packages sets the same property to the version KumikoUI.Uno depends on.
    -->

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
      SkiaRenderer brings in SkiaSharp.Views.Uno.WinUI (SKXamlCanvas) on every non-Windows head,
      matching what KumikoUI.Uno hosts the grid on.
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!--
    The Windows (WinAppSDK) head's SkiaSharp.Views package (SkiaSharp.Views.WinUI) is NOT pulled in
    by the SkiaRenderer UnoFeature, so reference it explicitly on the Windows head so SKXamlCanvas
    (used by KumikoUI.Uno) resolves there too. Uno dedups implicit references against explicit ones,
    keeping the version at $(SkiaSharpVersion).
  -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="SkiaSharp.Views.WinUI" />
  </ItemGroup>

  <!--
    Reference the library under test. KumikoUI.Uno is itself a multi-head Uno project with the SAME
    head TFMs as this app, so the per-head TargetFramework MUST flow through (no UndefineProperties)
    for the app's net10.0-desktop to bind the library's matching net10.0-desktop output. KumikoUI.Uno
    transitively brings in KumikoUI.Core + KumikoUI.SkiaSharp and already shields those single-TFM
    (net10.0-only) dependencies via its own UndefineProperties, so nothing extra is needed here.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/KumikoUI.Uno/KumikoUI.Uno.csproj" />
  </ItemGroup>

  <!--
    Demo fonts, shared with SampleApp.Maui from samples/Shared/Fonts (license texts live there too). Marked as
    Content so they are packaged into the app and resolvable via the ms-appx:///Assets/Fonts/<file>.ttf scheme used
    by KumikoFonts.RegisterFromAppPackageAsync in App.OnLaunched. KumikoUI.Uno itself ships no fonts —
    the consuming app supplies and registers them (see docs/uno/05-fonts-and-assets.md §4).
  -->
  <ItemGroup>
    <Content Include="../Shared/Fonts/NotoSansJP-Regular.ttf;../Shared/Fonts/MaterialIcons-Regular.ttf"
             Link="Assets/Fonts/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Avatars for the Images page, shared with SampleApp.Maui from samples/Shared/Images. Packaged as
    ms-appx:///Assets/Avatars/avatar-N.png.
  -->
  <ItemGroup>
    <Content Include="../Shared/Images/avatar-*.png" Link="Assets/Avatars/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The KumikoUI.Core package delivers the [KumikoGridItem] source generator as an analyzer; a project reference
    does not, so the sample references it directly. The sample's row types then read through generated accessors,
    which is what Native AOT and full trimming need (#76).
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/KumikoUI.SourceGenerators/KumikoUI.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="TargetFramework;TargetFrameworks" />
  </ItemGroup>

  <!-- Code shared with SampleApp.Maui, so both samples draw the same grid (the Grouping page's style). -->
  <ItemGroup>
    <Compile Include="../Shared/GroupingTheme.cs" Link="Shared/GroupingTheme.cs" />
    <Compile Include="../Shared/ShowcaseData.cs" Link="Shared/ShowcaseData.cs" />
  </ItemGroup>

  <!--
    WebAssembly head workaround for SkiaSharp.NativeAssets.WebAssembly 4.153.1 (#184).

    That package puts Dawn's emdawnwebgpu port on the native link line as source: it appends
    "-std=c++20 .../webgpu/src/webgpu.cpp" to EmccExtraLDFlags. The .NET WebAssembly SDK compiles every
    source on that line in one emcc invocation with the same flags, so the C++ standard also reaches
    Uno's C shim (uno_gl_shim.c, from Uno.WinUI.Runtime.Skia.WebAssembly.Browser), and clang fails with
    "invalid argument '-std=c++20' not allowed with 'C'". Clang has no per-language -std. Dropping the
    flag doesn't work (webgpu.cpp needs C++20 for std::span), and neither does opting out of the port
    with _SkiaSharpUseEmdawnwebgpu=false (libSkiaSharp.a then has undefined wgpu* symbols).

    So compile webgpu.cpp on its own, with C++20 and the flags the link line would have used, and link
    the object instead of the source. SkiaSharp fixes this upstream the same way from 4.156.0 (a release
    candidate at the time of writing), where webgpu.cpp ships inside libSkiaSharp.a:
    https://github.com/mono/SkiaSharp/pull/5316 (tracked for Uno in
    https://github.com/unoplatform/uno/issues/24507). Remove these targets once SkiaSharpVersion moves to
    a stable release with that fix; until then they do nothing when EmccExtraLDFlags carries no
    webgpu.cpp. The properties are set in a target because SkiaSharp's targets import after this file.
  -->
  <Target Name="_KumikoDetectEmdawnwebgpuSource" BeforeTargets="_BrowserWasmWriteRspForLinking">
    <PropertyGroup>
      <_KumikoEmdawnwebgpuSource Condition="'$(_SkiaSharpEmdawnwebgpuPkg)' != ''">$(_SkiaSharpEmdawnwebgpuPkg)/webgpu/src/webgpu.cpp</_KumikoEmdawnwebgpuSource>
      <_KumikoEmdawnwebgpuObject>$(_WasmIntermediateOutputPath)emdawnwebgpu.o</_KumikoEmdawnwebgpuObject>
      <_KumikoPrecompileEmdawnwebgpu Condition="'$(_KumikoEmdawnwebgpuSource)' != '' and $(EmccExtraLDFlags.Contains('-std=c++20 $(_KumikoEmdawnwebgpuSource)'))">true</_KumikoPrecompileEmdawnwebgpu>
    </PropertyGroup>
  </Target>

  <Target Name="_KumikoCompileEmdawnwebgpu"
          Condition="'$(_KumikoPrecompileEmdawnwebgpu)' == 'true'"
          Inputs="$(_KumikoEmdawnwebgpuSource);$(MSBuildProjectFullPath)"
          Outputs="$(_KumikoEmdawnwebgpuObject)">
    <ItemGroup>
      <!-- The SDK's common emcc flags, minus linker inputs such as Uno's -lidbfs.js. -->
      <_KumikoEmdawnwebgpuFlag Include="@(_EmccCommonFlags)" Condition="!$([System.String]::Copy('%(Identity)').StartsWith('-l'))" />
    </ItemGroup>
    <Exec Command='emcc "@$(_WasmDefaultFlagsRsp)" $(_WasmDefaultFlags) $(WasmLinkOptimizationFlag) @(_KumikoEmdawnwebgpuFlag, &apos; &apos;) -std=c++20 -isystem "$(_SkiaSharpEmdawnwebgpuPkg)/webgpu/include" -isystem "$(_SkiaSharpEmdawnwebgpuPkg)/webgpu_cpp/include" -c "$(_KumikoEmdawnwebgpuSource)" -o "$(_KumikoEmdawnwebgpuObject)"'
          EnvironmentVariables="@(EmscriptenEnvVars)" />
    <ItemGroup>
      <FileWrites Include="$(_KumikoEmdawnwebgpuObject)" />
    </ItemGroup>
  </Target>

  <Target Name="_KumikoLinkEmdawnwebgpuObject"
          AfterTargets="_KumikoDetectEmdawnwebgpuSource"
          BeforeTargets="_BrowserWasmWriteRspForLinking"
          DependsOnTargets="_KumikoCompileEmdawnwebgpu"
          Condition="'$(_KumikoPrecompileEmdawnwebgpu)' == 'true'">
    <PropertyGroup>
      <EmccExtraLDFlags>$(EmccExtraLDFlags.Replace('-std=c++20 $(_KumikoEmdawnwebgpuSource)', '&quot;$(_KumikoEmdawnwebgpuObject)&quot;'))</EmccExtraLDFlags>
    </PropertyGroup>
    <ItemGroup>
      <_WasmLinkDependencies Include="$(_KumikoEmdawnwebgpuObject)" />
    </ItemGroup>
  </Target>

</Project>
