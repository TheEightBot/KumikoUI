<Page x:Class="SampleApp.Uno.ExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:kumiko="using:KumikoUI.Uno"
      xmlns:core="using:KumikoUI.Core.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Export — what the grid shows, as CSV"
                   FontSize="20"
                   FontWeight="Bold"
                   Padding="16,12"
                   Grid.Row="0" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="16,4" Spacing="8">
                <Button Content="Export CSV" Click="OnExportClicked" />
                <CheckBox x:Name="selectedCheck" Content="Selected rows only" />
                <CheckBox x:Name="groupCheck" Content="Group by department" Checked="OnGroupChanged" Unchecked="OnGroupChanged" />
                <TextBlock x:Name="statusLabel" VerticalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- Sorting, filtering and grouping apply to the export: it writes the rows the grid shows (rows of collapsed
             groups included), in the grid's column order. -->
        <kumiko:KumikoDataGrid x:Name="kumiko"
                               Grid.Row="2"
                               AllowSorting="True"
                               AllowFiltering="True"
                               SelectionMode="Extended"
                               GridDescription="Employees, exportable as CSV"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch">
            <kumiko:KumikoDataGrid.Columns>
                <core:KumikoColumn Header="Id" PropertyName="Id" Width="70" ColumnType="Numeric" IsReadOnly="True" />
                <core:KumikoColumn Header="Name" PropertyName="Name" Width="160" />
                <core:KumikoColumn Header="Department" PropertyName="Department" Width="130" />
                <core:KumikoColumn Header="Salary" PropertyName="Salary" Width="110" ColumnType="Numeric" Format="C0" TextAlignment="Right" />
                <core:KumikoColumn Header="Score" PropertyName="Score" Width="90" ColumnType="Numeric" Format="N1" TextAlignment="Right" />
                <core:KumikoColumn Header="Active" PropertyName="IsActive" Width="80" ColumnType="Boolean" />
            </kumiko:KumikoDataGrid.Columns>
            <kumiko:KumikoDataGrid.TableSummaryRows>
                <core:TableSummaryRow Name="Total" Position="Bottom" Title="Total">
                    <core:TableSummaryRow.Columns>
                        <core:SummaryColumnDescription PropertyName="Salary" SummaryType="Sum" Format="C0" />
                    </core:TableSummaryRow.Columns>
                </core:TableSummaryRow>
            </kumiko:KumikoDataGrid.TableSummaryRows>
        </kumiko:KumikoDataGrid>
    </Grid>
</Page>
