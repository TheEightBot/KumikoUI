{
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:8080",
      "sslPort": 0
    }
  },
  "profiles": {
    // Desktop (Skia) is listed first so `dotnet run` and the IDE default to it.
    "SampleApp.Uno (Desktop)": {
      "commandName": "Project",
      "compatibleTargetFramework": "desktop"
    },
    // Each profile MUST declare compatibleTargetFramework, otherwise Rider can't map the
    // profile to a head and selecting "Desktop" launches the WebAssembly target instead
    // (see https://github.com/unoplatform/uno/issues/21153).
    "SampleApp.Uno (WebAssembly)": {
      "commandName": "Project",
      "compatibleTargetFramework": "browserwasm",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5000",
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "SampleApp.Uno (WebAssembly IIS Express)": {
      "commandName": "IISExpress",
      "compatibleTargetFramework": "browserwasm",
      "launchBrowser": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    // Note: In order to select this profile, you'll need to comment the `Packaged` profile below until this is fixed: https://aka.platform.uno/wasdk-maui-debug-profile-issue
    "SampleApp.Uno (WinAppSDK Unpackaged)": {
      "commandName": "Project",
      "compatibleTargetFramework": "windows"
    },
    "SampleApp.Uno (WinAppSDK Packaged)": {
      "commandName": "MsixPackage",
      "compatibleTargetFramework": "windows"
    },
    "SampleApp.Uno (Desktop WSL2)": {
      "commandName": "WSL2",
      "commandLineArgs": "{ProjectDir}/bin/Debug/net10.0-desktop/SampleApp.Uno.dll",
      "distributionName": "",
      "compatibleTargetFramework": "desktop"
    }
  }
}
