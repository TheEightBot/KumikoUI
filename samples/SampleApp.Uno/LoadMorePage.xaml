<Page x:Class="SampleApp.Uno.LoadMorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:kumiko="using:KumikoUI.Uno"
      xmlns:core="using:KumikoUI.Core.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Load More — orders loaded in batches from a simulated server"
                   FontSize="20"
                   FontWeight="Bold"
                   Padding="16,12"
                   Grid.Row="0" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="16,4" Spacing="8">
                <ComboBox x:Name="modeBox" SelectionChanged="OnModeChanged" VerticalAlignment="Center" />
                <CheckBox x:Name="failCheck" Content="Fail next request" Checked="OnFailChanged" Unchecked="OnFailChanged" />
                <Button Content="Start over" Click="OnStartOverClicked" />
                <TextBlock x:Name="statusLabel" VerticalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- The items are a KumikoIncrementalCollection: the grid loads the next batch as the user nears the end,
             shows a loading row meanwhile and an error row with Retry when a batch fails. Sorting applies to the
             loaded rows; the totals are over the loaded rows too. Pull the rows down from the top to reload them
             (RefreshCommand); "Start over" reloads the same way without the gesture. -->
        <kumiko:KumikoDataGrid x:Name="kumiko"
                               Grid.Row="2"
                               AllowSorting="True"
                               AllowFiltering="True"
                               LoadMoreRequested="OnLoadMoreRequested"
                               LoadMoreCompleted="OnLoadMoreCompleted"
                               IsPullToRefreshEnabled="True"
                               GridDescription="Orders loaded on demand"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch">
            <kumiko:KumikoDataGrid.Columns>
                <core:KumikoColumn Header="Order" PropertyName="Id" Width="90" ColumnType="Numeric" IsReadOnly="True" />
                <core:KumikoColumn Header="Customer" PropertyName="Customer" Width="140" />
                <core:KumikoColumn Header="Region" PropertyName="Region" Width="110" />
                <core:KumikoColumn Header="Total" PropertyName="Total" Width="110" ColumnType="Numeric" Format="C2" TextAlignment="Right" />
                <core:KumikoColumn Header="Placed" PropertyName="Placed" Width="150" ColumnType="Date" Format="g" />
            </kumiko:KumikoDataGrid.Columns>
            <kumiko:KumikoDataGrid.TableSummaryRows>
                <core:TableSummaryRow Name="Loaded" Position="Bottom" Title="Loaded">
                    <core:TableSummaryRow.Columns>
                        <core:SummaryColumnDescription PropertyName="Id" SummaryType="Count" Format="N0" />
                        <core:SummaryColumnDescription PropertyName="Total" SummaryType="Sum" Format="C0" />
                    </core:TableSummaryRow.Columns>
                </core:TableSummaryRow>
            </kumiko:KumikoDataGrid.TableSummaryRows>
        </kumiko:KumikoDataGrid>
    </Grid>
</Page>
