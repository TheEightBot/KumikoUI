<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>SampleApp.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>SampleApp.Maui</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.sampleapp.maui</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

	</PropertyGroup>

	<!--
		Native AOT publish check (#76): CI passes -p:KumikoPublishAot=true. A property of its own, not PublishAot
		on the command line, because a global PublishAot would also flow to the plain net10.0 library projects,
		which cannot be AOT-compiled for an iOS or Mac Catalyst runtime identifier.
	-->
	<PropertyGroup Condition="'$(KumikoPublishAot)' == 'true'">
		<PublishAot>true</PublishAot>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts: shared with SampleApp.Uno from samples/Shared/Fonts (license texts live there too). -->
		<MauiFont Include="..\Shared\Fonts\OpenSans-*.ttf" Link="Resources\Fonts\%(Filename)%(Extension)" />

		<!--
			Fonts the grid draws with. They are registered through KumikoFonts.RegisterFromAppPackageAsync, which
			reads them from the app package, so they ship as raw assets under their file name.
		-->
		<MauiAsset Include="..\Shared\Fonts\NotoSansJP-Regular.ttf;..\Shared\Fonts\MaterialIcons-Regular.ttf"
				   Link="Resources\Raw\%(Filename)%(Extension)" LogicalName="%(Filename)%(Extension)" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Avatars for the Images page, shared with SampleApp.Uno: packaged as Avatars/avatar-N.png -->
		<MauiAsset Include="..\Shared\Images\avatar-*.png" LogicalName="Avatars/%(Filename)%(Extension)" Link="Resources\Raw\Avatars\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="../../src/KumikoUI.Maui/KumikoUI.Maui.csproj" />
	</ItemGroup>

	<!--
		.NET MAUI DevFlow (#262): the in-app automation agent and the sample's KumikoUI extension (DevFlow/), so
		eng/devflow and the maui devflow CLI can drive the sample. On by default in Debug builds; pass
		-p:KumikoDevFlow=false to build a Debug sample without it. Never in Release: other configurations reference
		and compile none of it, whatever KumikoDevFlow says.
		- The agent needs a newer Microsoft.Maui.Core than MauiVersion (the library's floor), so Microsoft.Maui.Controls
		  follows MauiDevFlowMauiVersion while DevFlow is on, keeping Controls and Core from the same MAUI release.
		- Mac Catalyst signs with Entitlements.Debug.plist, which adds the network.server entitlement the agent's HTTP
		  listener needs inside the sandbox.
	-->
	<PropertyGroup>
		<KumikoDevFlow Condition="'$(KumikoDevFlow)' == ''">true</KumikoDevFlow>
		<KumikoDevFlow Condition="'$(Configuration)' != 'Debug'">false</KumikoDevFlow>
		<DefineConstants Condition="'$(KumikoDevFlow)' == 'true'">$(DefineConstants);KUMIKO_DEVFLOW</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(KumikoDevFlow)' == 'true'">
		<PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
		<PackageReference Update="Microsoft.Maui.Controls" VersionOverride="$(MauiDevFlowMauiVersion)" />
	</ItemGroup>
	<ItemGroup Condition="'$(KumikoDevFlow)' != 'true'">
		<Compile Remove="DevFlow/**" />
	</ItemGroup>
	<PropertyGroup Condition="'$(KumikoDevFlow)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<CodeSignEntitlements>Platforms/MacCatalyst/Entitlements.Debug.plist</CodeSignEntitlements>
	</PropertyGroup>

	<!--
		The KumikoUI.Core package delivers the [KumikoGridItem] source generator as an analyzer; a project reference
		does not, so the sample references it directly. The sample's row types then read through generated accessors,
		which is what Native AOT and full trimming need (#76).
	-->
	<ItemGroup>
		<ProjectReference Include="../../src/KumikoUI.SourceGenerators/KumikoUI.SourceGenerators.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- Code shared with SampleApp.Uno, so both samples draw the same grid (the Grouping page's style). -->
	<ItemGroup>
		<Compile Include="../Shared/GroupingTheme.cs" Link="Shared/GroupingTheme.cs" />
	</ItemGroup>

</Project>
