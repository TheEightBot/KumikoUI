<Project>
  <!--
    Central package management: every NuGet package version used in this repository is declared here,
    exactly once. Project files reference packages without a Version attribute.
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      One SkiaSharp version for the whole repository. Uno.Sdk projects also read this property for
      their implicit SkiaSharp package group (Uno would otherwise default to 3.x). KumikoUI.SkiaSharp is
      shared by the MAUI and Uno hosts, so mixing majors would put two incompatible native libraries in
      one app. SkiaSharp 4's runtime assembly keeps the v3 members (they are only removed from the
      reference assembly), so Uno's own runtime, compiled against 3.x, binds unchanged.
    -->
    <SkiaSharpVersion>4.153.1</SkiaSharpVersion>

    <!--
      Minimum .NET MAUI version KumikoUI.Maui supports. It becomes the package's dependency floor, so it
      no longer floats with whatever MAUI workload the build machine has. 10.0.20 is also the floor of
      SkiaSharp.Views.Maui.Controls 4.153.1. Dependabot ignores it (.github/dependabot.yml); raise it by hand.
    -->
    <MauiVersion>10.0.20</MauiVersion>

    <!--
      Version of Microsoft.Windows.Compatibility that Uno.Sdk adds implicitly to WebAssembly heads
      (Uno 6.7 defaults to 9.0.x). 10.0.13 brings System.Security.Cryptography.Pkcs/Xml 10.0.13, which fix
      the high-severity advisories reported against 10.0.12 (NU1903).
    -->
    <WindowsCompatibilityVersion>10.0.13</WindowsCompatibilityVersion>

    <!--
      Versions of the platform packages eng/TypeNameCheck reads to compare public type names. They are only
      downloaded by that build tool (PackageDownload); nothing in the shipped packages references them.
        - WinUI: the Microsoft.UI.Xaml.* metadata (Windows App SDK).
        - Uno: Uno's own Microsoft.UI.Xaml implementation, which has public types WinUI lacks. Keep it at the
          Uno.WinUI version that Uno.Sdk (global.json) resolves.
        - Windows Forms: the System.Windows.Forms.* reference assemblies.
      MAUI uses MauiVersion above (the minimum KumikoUI.Maui supports).
    -->
    <WindowsAppSdkWinUIVersion>1.8.260528001</WindowsAppSdkWinUIVersion>
    <UnoWinUIVersion>6.7.135</UnoWinUIVersion>
    <WindowsDesktopRefVersion>10.0.13</WindowsDesktopRefVersion>
  </PropertyGroup>

  <ItemGroup Label="Rendering (SkiaSharp)">
    <PackageVersion Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.Views" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.Views.Maui.Controls" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.Views.WinUI" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.Skottie" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup Label="Hosts">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!--
    Listed so Dependabot sees them. The MAUI packages follow MauiVersion and Uno.WinUI follows Uno.Sdk, so
    they are deliberately not listed here: a PackageVersion for them could override the versions the MAUI
    and Uno SDKs choose for the real projects.
  -->
  <ItemGroup Label="Build tools (eng/TypeNameCheck)">
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="$(WindowsAppSdkWinUIVersion)" />
    <PackageVersion Include="Microsoft.WindowsDesktop.App.Ref" Version="$(WindowsDesktopRefVersion)" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
